package user_profile

import (
	"testing"

	"github.com/omyo-group/gonest"
)

var _ gonest.Pipe = (*UserProfilePipe)(nil)

func TestUserProfilePipeTransform(t *testing.T) {
	got, err := NewUserProfilePipe().Transform(nil, "value", gonest.ArgMeta{})
	if err != nil || got != "value" {
		t.Fatalf("Transform = %v, %v; want value, nil", got, err)
	}
}
