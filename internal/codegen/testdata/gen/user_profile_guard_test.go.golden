package user_profile

import (
	"testing"

	"github.com/omyo/gonest"
)

var _ gonest.Guard = (*UserProfileGuard)(nil)

func TestUserProfileGuardCanActivate(t *testing.T) {
	ok, err := NewUserProfileGuard().CanActivate(nil)
	if err != nil || !ok {
		t.Fatalf("CanActivate = %v, %v; want true, nil", ok, err)
	}
}
