package user_profile

import "github.com/omyo-group/gonest"

// UserProfileGuard authorises requests. Attach it with gonest.UseGuards(&UserProfileGuard{}).
type UserProfileGuard struct{}

// NewUserProfileGuard is the constructor registered in the module's Providers.
func NewUserProfileGuard() *UserProfileGuard {
	return &UserProfileGuard{}
}

// CanActivate implements gonest.Guard. Return (false, nil) for 403, or an
// error such as gonest.Unauthorized for another status.
func (g *UserProfileGuard) CanActivate(_ *gonest.Ctx) (bool, error) {
	return true, nil
}
