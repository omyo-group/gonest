package user_profile

import "github.com/omyo/gonest"

// UserProfileInterceptor wraps handler execution. Code before next() runs before the
// handler, code after it can inspect or replace the result.
type UserProfileInterceptor struct{}

// NewUserProfileInterceptor is the constructor registered in the module's Providers.
func NewUserProfileInterceptor() *UserProfileInterceptor {
	return &UserProfileInterceptor{}
}

// Intercept implements gonest.Interceptor.
func (i *UserProfileInterceptor) Intercept(_ *gonest.Ctx, next gonest.Next) (any, error) {
	return next()
}
