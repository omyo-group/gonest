# syntax=docker/dockerfile:1
FROM golang:1.24 AS build
WORKDIR /src
COPY go.mod go.sum* ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/{{.Name.Kebab}} .

FROM gcr.io/distroless/static-debian12:nonroot
COPY --from=build /out/{{.Name.Kebab}} /{{.Name.Kebab}}
EXPOSE 8080
USER nonroot:nonroot
ENTRYPOINT ["/{{.Name.Kebab}}"]
