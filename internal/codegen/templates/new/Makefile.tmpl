BINARY := {{.Name.Kebab}}

.PHONY: build run test lint fmt docker clean

build:
	CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o bin/$(BINARY) .

run:
	go run .

test:
	go test -race ./...

lint:
	golangci-lint run ./...

fmt:
	gofmt -s -w .

docker:
	docker build -t $(BINARY) .

clean:
	rm -rf bin
